#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
python3 -m unittest discover -s tests -v
python3 -m py_compile mouse-warp.py shake_find.py cursor_shapes.py theme_cursor.py compositor_support.py preview.py
xvfb-run -a python3 tests/x11_smoke.py
xvfb-run -a python3 tests/service_arrival_smoke.py
xvfb-run -a python3 tests/effect_overlap_smoke.py
xvfb-run -a python3 tests/border_flash_smoke.py

if [ -d /usr/share/icons/capitaine-cursors ] && [ -d /usr/share/icons/capitaine-cursors-light ]; then
    xvfb-run -a python3 tests/theme_artwork_smoke.py
fi

if command -v xcompmgr >/dev/null 2>&1; then
    xvfb-run -a python3 tests/preview_smoke.py
fi
